# Chutes.ai API Configuration
CHUTES_API_TOKEN=your_chutes_api_token_here

# Optional: Model Selection Preferences (uncomment and modify as needed)
# CHUTES_DEFAULT_MODEL=deepseek-ai/DeepSeek-R1  # Default model for general tasks
# CHUTES_FAST_MODEL=FLUX.1-schnell              # Model for quick responses
# CHUTES_CODE_MODEL=Qwen/Qwen2.5-Coder-32B     # Model for code generation
# CHUTES_UI_MODEL=bytedance-research/UI-TARS    # Model for UI/UX tasks

# Optional: Cost Management (uncomment and modify as needed)
# CHUTES_MAX_DAILY_COST=10.0                    # Maximum daily spending limit in USD
# CHUTES_COST_ALERT_THRESHOLD=0.8               # Alert when reaching % of daily limit

# Optional: Performance Settings
# CHUTES_REQUEST_TIMEOUT=30                     # API request timeout in seconds
# CHUTES_MAX_RETRIES=3                         # Maximum number of retry attempts
# CHUTES_TEMPERATURE=0.7                       # Default temperature for model responses

# Note: Only CHUTES_API_TOKEN is required. Other settings are optional and will
# use sensible defaults if not specified.